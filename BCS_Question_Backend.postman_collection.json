{
	"info": {
		"name": "BCS Question Backend",
		"description": "Complete API Collection for BCS Question Backend with standardized response format ({ success, message, data / errorMessages })",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"username\": \"testuser\",\n    \"password\": \"yourpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register/",
							"host": ["{{base_url}}"],
							"path": ["auth", "register", ""]
						},
						"description": "Register a new user account. Generates and sends a 6-digit OTP to the provided email for verification."
					},
					"response": [
						{
							"name": "201 Created",
							"status": "Created",
							"code": 201,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"OTP sent to your email\",\n    \"data\": null\n}"
						}
					]
				},
				{
					"name": "Verify Registration OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-otp/",
							"host": ["{{base_url}}"],
							"path": ["auth", "verify-otp", ""]
						},
						"description": "Verify registration OTP (5-minute expiration). On success, activates the account and auto-saves JWT access/refresh tokens to collection variables."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.collectionVariables.set('access_token', json.data.token);",
									"        pm.collectionVariables.set('refresh_token', json.data.refresh);",
									"    }",
									"}"
								]
							}
						}
					],
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Account verified successfully\",\n    \"data\": {\n        \"token\": \"eyJhbGciOiJIUzI1Ni...\",\n        \"refresh\": \"eyJhbGciOiJIUzI1Ni...\",\n        \"user_info\": {\n            \"id\": 1,\n            \"email\": \"user@example.com\",\n            \"username\": \"testuser\",\n            \"is_verified\": true\n        }\n    }\n}"
						}
					]
				},
				{
					"name": "Resend Registration OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/resend-verification-otp/",
							"host": ["{{base_url}}"],
							"path": ["auth", "resend-verification-otp", ""]
						},
						"description": "Resends verification OTP to an unverified user's email. Enforces a 60-second cooldown."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"A new OTP has been sent to your email.\",\n    \"data\": null\n}"
						},
						{
							"name": "429 Rate Limited",
							"status": "Too Many Requests",
							"code": 429,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": false,\n    \"message\": \"Please wait 60 seconds before requesting a new OTP.\",\n    \"errorMessages\": [\n        {\n            \"path\": \"\",\n            \"message\": \"Please wait 60 seconds before requesting a new OTP.\"\n        }\n    ]\n}"
						}
					]
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"yourpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login/",
							"host": ["{{base_url}}"],
							"path": ["auth", "login", ""]
						},
						"description": "Login with email and password. Automatically saves access_token and refresh_token to collection variables."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.token) {",
									"        pm.collectionVariables.set('access_token', json.data.token);",
									"        pm.collectionVariables.set('refresh_token', json.data.refresh);",
									"    }",
									"}"
								]
							}
						}
					],
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Login successfully\",\n    \"data\": {\n        \"token\": \"eyJhbGciOiJIUzI1Ni...\",\n        \"refresh\": \"eyJhbGciOiJIUzI1Ni...\",\n        \"user_info\": {\n            \"id\": 1,\n            \"email\": \"user@example.com\",\n            \"username\": \"testuser\",\n            \"is_verified\": true\n        }\n    }\n}"
						}
					]
				},
				{
					"name": "Token Refresh",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/token/refresh/",
							"host": ["{{base_url}}"],
							"path": ["auth", "token", "refresh", ""]
						},
						"description": "Exchange a valid refresh token for a fresh access token. Automatically updates {{access_token}}."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.access) {",
									"        pm.collectionVariables.set('access_token', json.data.access);",
									"    }",
									"}"
								]
							}
						}
					],
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Token refreshed successfully\",\n    \"data\": {\n        \"access\": \"eyJhbGciOiJIUzI1Ni...\"\n    }\n}"
						}
					]
				},
				{
					"name": "Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/profile/",
							"host": ["{{base_url}}"],
							"path": ["auth", "profile", ""]
						},
						"description": "Get profile details of the authenticated user."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Profile retrieved successfully\",\n    \"data\": {\n        \"user_info\": {\n            \"id\": 1,\n            \"email\": \"user@example.com\",\n            \"username\": \"testuser\",\n            \"is_verified\": true\n        }\n    }\n}"
						}
					]
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"current_password\": \"yourpassword123\",\n    \"new_password\": \"newpassword123\",\n    \"confirm_password\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/change-password/",
							"host": ["{{base_url}}"],
							"path": ["auth", "change-password", ""]
						},
						"description": "Change password for logged-in user by providing current password."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Password changed successfully\",\n    \"data\": null\n}"
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/logout/",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout", ""]
						},
						"description": "Logout and blacklist the refresh token."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Logged out successfully\",\n    \"data\": null\n}"
						}
					]
				}
			],
			"description": "Authentication and user lifecycle endpoints."
		},
		{
			"name": "Password Reset",
			"item": [
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/forgot-password/",
							"host": ["{{base_url}}"],
							"path": ["auth", "forgot-password", ""]
						},
						"description": "Request password reset OTP (60s cooldown)."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"OTP sent to your email\",\n    \"data\": null\n}"
						}
					]
				},
				{
					"name": "Verify Reset OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-reset-otp/",
							"host": ["{{base_url}}"],
							"path": ["auth", "verify-reset-otp", ""]
						},
						"description": "Verify password reset OTP (5-minute expiration)."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"OTP verified successfully\",\n    \"data\": null\n}"
						}
					]
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"code\": \"123456\",\n    \"new_password\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/reset-password/",
							"host": ["{{base_url}}"],
							"path": ["auth", "reset-password", ""]
						},
						"description": "Reset password using verified OTP (5-minute expiration)."
					},
					"response": [
						{
							"name": "200 Success",
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"success\": true,\n    \"message\": \"Password reset successful\",\n    \"data\": null\n}"
						}
					]
				}
			],
			"description": "Password reset and recovery flow."
		}
	]
}
